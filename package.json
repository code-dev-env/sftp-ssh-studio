{
  "name": "sftp-studio",
  "version": "1.0.0",
  "description": "SFTP Studio - SFTP file browser, text editor and SSH terminal",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.sftpstudio.app",
    "productName": "SFTP Studio",
    "win": {
      "target": ["portable", "nsis"],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "files": [
      "main.js",
      "index.html",
      "build/icon.png",
      "renderer.js",
      "package.json"
    ],
    "portable": {
      "artifactName": "SFTPStudio-Portable.exe"
    },
    "nsis": {
      "artifactName": "SFTPStudio-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
