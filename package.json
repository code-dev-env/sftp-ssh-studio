{
  "name": "custom-sftp",
  "version": "1.0.0",
  "description": "Custom SFTP terminal + file browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "local.custom.sftp",
    "productName": "Custom SFTP",
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "files": [
      "main.js",
      "index.html",
      "build/icon.png",
      "renderer.js",
      "package.json"
    ],
    "portable": {
      "artifactName": "CustomSFTP.exe"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
